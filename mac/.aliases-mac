alias flux="ollama run x/flux2-klein:4b"
alias z-image="ollama run x/z-image-turbo:latest"

update_docker_mcp() {
  # curl -L https://github.com/docker/mcp-gateway/releases/latest/download/docker-mcp-darwin-arm64.tar.gz -o docker-mcp-darwin-arm64.tar.gz
  # gh release download -R docker/mcp-gateway --pattern 'docker-mcp-darwin-arm64.tar.gz'
  OWNER="docker"
  REPO="mcp-gateway"
  PATTERN="docker-mcp-darwin-arm64.tar.gz"  

  # Get the latest pre-release tag (released in descending order by default)
  TAG=$(gh release list -R "$OWNER/$REPO" \
        --json tagName,isPrerelease \
      | jq -r '
          .[]
          | select(.isPrerelease == true)
          | .tagName
      ' | head -n 1)

  if [[ -z "$TAG" ]]; then
    echo "No pre-releases found in $OWNER/$REPO"
    return 1
  fi

  echo "Latest pre-release: $TAG"

  gh release download "$TAG" -R "$OWNER/$REPO" -p "$PATTERN" -O - | tar xvf - 
  chmod +x ./docker-mcp
  echo "Downloaded $PATTERN"
  mkdir -p "$HOME/.docker/cli-plugins/"
  mv -f docker-mcp "$HOME/.docker/cli-plugins/"
  echo "installed docker-mcp into plugin folder"
}

# useful dir

alias vault-ob="cd ~/Documents/vaults/personal\ notes"

